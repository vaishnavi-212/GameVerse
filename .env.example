# Public Supabase browser configuration.
# Use the publishable key from Supabase Project > Connect.
# Never put a service_role/secret key in a VITE_ variable.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Legacy projects may use this name instead:
# VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Existing optional Gemini configuration, if your project uses it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
